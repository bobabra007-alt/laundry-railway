# Required Vercel Production settings (also supported locally).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
AUTH_SECRET="generate-a-random-secret-in-START-HERE.html"
ADMIN_PASSWORD="choose-your-first-admin-password-minimum-12-characters"
# Optional: direct connection for migrations if DATABASE_URL is pooled.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Optional attachments: connect a private Vercel Blob store.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
