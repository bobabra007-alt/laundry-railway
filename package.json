{
  "name": "laundra",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/start.mjs",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:prepare": "node scripts/prepare-db.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@vercel/blob": "^2.0.0",
    "bcryptjs": "^3.0.2",
    "next": "16.3.8",
    "next-auth": "beta",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12",
    "@prisma/client": "^7.10.0",
    "prisma": "^7.10.0",
    "tsx": "^4.20.6",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "@electric-sql/pglite": "0.4.3",
    "@electric-sql/pglite-socket": "0.1.3"
  },
  "engines": {
    "node": "24.x"
  }
}
